# ===========================================
# REQUIRED VARIABLES (app will fail without these in production)
# ===========================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_generate_with_python_secrets

# Database password (used in DATABASE_URL construction)
DB_PASSWORD=your_strong_database_password

# Redis password
REDIS_PASSWORD=your_strong_redis_password

# ===========================================
# OPTIONAL VARIABLES (have sensible defaults)
# ===========================================

# Application environment: development, testing, production
FLASK_ENV=development

# Port to run on
PORT=5000

# Full database URL (constructed automatically in docker-compose, set manually for external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/artist_analyzer

# Full Redis URL (constructed automatically in docker-compose, set manually for external Redis)
# REDIS_URL=redis://:password@localhost:6379/0

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# Force HTTPS redirect (default: true in production, set to false for local Docker testing)
FORCE_HTTPS=false
